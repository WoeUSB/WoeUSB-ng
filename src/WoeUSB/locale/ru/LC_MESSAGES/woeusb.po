#: core.py:85
msgid "You need to specify installation type (--device or --partition)"
msgstr "Необходимо указать тип установки (--device или --partition)"

#: core.py:148
#, python-brace-format
msgid "Warning: You are not running {0} as root!"
msgstr "Предупреждение: запуск {0} выполнен не от имени пользователя root!"

#: core.py:149
msgid "Warning: This might be the reason of the following failure."
msgstr "Предупреждение: это может привести к сбою."

#: core.py:163
msgid "Error: Unable to mount source filesystem"
msgstr "Ошибка: не удалось подключить исходную файловую систему"

#: core.py:186
msgid "Error: Unable to mount target filesystem"
msgstr "Ошибка: не удалось подключить целевую файловую систему"

#: core.py:222
#, python-brace-format
msgid "Wiping all existing partition table and filesystem signatures in {0}"
msgstr ""
"Удаление всех существующих таблиц разделов и подписей файловой системы на {0}"

#: core.py:236
#, python-brace-format
msgid "Ensure that {0} is really wiped..."
msgstr "Проверка факта очистки {0}..."

#: core.py:243
msgid ""
"Error: Partition is still detected after wiping all signatures, this"
" indicates that the drive might be locked into readonly mode due to end of"
" lifespan."
msgstr ""
"Ошибка: раздел продолжает определяться после удаления всех подписей. Это"
" означает, что диск может находиться в режиме «только чтение» из-за истечения"
" срока службы."

#: core.py:257
#, python-brace-format
msgid "Creating new partition table on {0}..."
msgstr "Создание новой таблицы разделов на {0}..."

#: core.py:262
msgid "Error: Currently GUID partition table is not supported."
msgstr ""
"Ошибка: в текущей версии программы таблица разделов GUID не поддерживается."

#: core.py:265
msgid "Error: Partition table not supported."
msgstr "Ошибка: таблица разделов не поддерживается."

#: core.py:292
msgid "Error: Filesystem not supported"
msgstr "Ошибка: файловая система не поддерживается"

#: core.py:295
msgid "Creating target partition..."
msgstr "Создание целевого раздела..."

#: core.py:326
msgid "FATAL: Illegal parted_mkpart_fs_type, please report bug."
msgstr ""
"КРИТИЧЕСКАЯ ОШИБКА: недопустимый parted_mkpart_fs_type. Сообщите"
" разработчикам об ошибке."

#: core.py:338
msgid "FATAL: Shouldn't be here"
msgstr "КРИТИЧЕСКАЯ ОШИБКА: этого здесь быть не должно"

#: core.py:378
msgid ""
"Warning: Unable to download UEFI:NTFS partition image from GitHub,"
" installation skipped.  Target device might not be bootable if the UEFI"
" firmware doesn't support NTFS filesystem."
msgstr ""
"Предупреждение: не удалось загрузить образ раздела UEFI:NTFS с GitHub."
" Установка пропущена. Запуск целевого устройства может оказаться невозможным,"
" если микропрограмма UEFI не поддерживает файловую систему NTFS."

#: core.py:394
msgid "Mounting source filesystem..."
msgstr "Подключение исходной файловой системы..."

#: core.py:399 core.py:434
#, python-brace-format
msgid "Error: Unable to create {0} mountpoint directory"
msgstr "Ошибка: не удалось создать каталог точки подключения {0}"

#: core.py:408 core.py:415
msgid "Error: Unable to mount source media"
msgstr "Ошибка: не удалось подключить исходный носитель"

#: core.py:429
msgid "Mounting target filesystem..."
msgstr "Подключение целевой файловой системы..."

#: core.py:440
msgid "Error: Unable to mount target media"
msgstr "Ошибка: не удалось подключить целевой носитель"

#: core.py:462
msgid "Copying files from source media..."
msgstr "Копирование файлов с исходного носителя..."

#: core.py:520
msgid "Installing GRUB bootloader for legacy PC booting support..."
msgstr ""
"Установка загрузчика GRUB для поддержки устаревшего способа запуска ПК..."

#: core.py:541
msgid "Installing custom GRUB config for legacy PC booting..."
msgstr ""
"Установка настраиваемого конфигурационного файла GRUB для устаревшего способа"
" запуска ПК..."

#: core.py:560
#, python-brace-format
msgid "Unmounting and removing {0}..."
msgstr "Отключение и удаление {0}..."

#: core.py:562
msgid "Warning: Unable to unmount filesystem."
msgstr "Предупреждение: не удалось отключить файловую систему."

#: core.py:568
msgid "Warning: Unable to remove source mountpoint"
msgstr "Предупреждение: не удалось удалить точку подключения источника"

#: core.py:600 core.py:607
msgid ""
"Some mountpoints are not unmount/cleaned successfully and must be done"
" manually"
msgstr ""
"Некоторые точки подключения не были успешно отключены/очищены; это необходимо"
" выполнить вручную"

#: core.py:605
msgid ""
"We unable to unmount target filesystem for you, please make sure target"
" filesystem is unmounted before detaching to prevent data corruption"
msgstr ""
"Программе не удалось отключить целевую файловую систему. Обязательно"
" отключите целевую файловую систему перед отсоединением устройства, чтобы"
" предотвратить повреждение данных"

#: core.py:612
msgid ""
"Target device is busy, please make sure you unmount all filesystems on target"
" device or shutdown the computer before detaching it."
msgstr ""
"Целевое устройство занято. Обязательно отключите все файловые системы на"
" целевом устройстве или выключите компьютер перед отсоединением этого"
" устройства."

#: core.py:615
msgid "You may now safely detach the target device"
msgstr "Теперь целевое устройство можно без опасений отсоединить"

#: core.py:620
msgid "Done :)"
msgstr "Готово :)"

#: core.py:621
msgid "The target device should be bootable now"
msgstr "Теперь целевое устройство должно быть доступно для запуска"

#: gui.py:34
msgid "Show all drives"
msgstr "Показать все диски"

#: gui.py:35
msgid "Show all drives, even those not detected as USB stick."
msgstr ""
"Показать все диски — даже те, которые не определяются как USB-накопитель."

#: gui.py:46
msgid "Set boot flag"
msgstr "Установить флаг загрузки"

#: gui.py:47
msgid "Sets boot flag after process of copying."
msgstr "Установить флаг загрузки после процесса копирования."

#: gui.py:49
msgid "Use NTFS"
msgstr "Использовать NTFS"

#: gui.py:50
msgid "Use NTFS instead of FAT. NOTE: NTFS seems to be slower than FAT."
msgstr "Использовать NTFS вместо FAT. ПРИМЕЧАНИЕ: NTFS работает медленнее FAT."

#: gui.py:56
msgid "&File"
msgstr "&Файл"

#: gui.py:57
msgid "&Options"
msgstr "&Параметры"

#: gui.py:58
msgid "&Help"
msgstr "&Справка"

#: gui.py:114
msgid "Source :"
msgstr "Источник:"

#: gui.py:117
msgid "From a disk image (iso)"
msgstr "Образ диска (iso)"

#: gui.py:122
msgid "Please select a disk image"
msgstr "Выберите образ диска"

#: gui.py:128
msgid "From a CD/DVD drive"
msgstr "CD/DVD-диск"

#: gui.py:141
msgid "Target device :"
msgstr "Целевое устройство:"

#: gui.py:153
msgid "Install"
msgstr "Установить"

#: gui.py:243
msgid "Installing"
msgstr "Установка"

#: gui.py:243
msgid "Please wait..."
msgstr "Подождите..."

#: gui.py:254
msgid "Are you sure you want to cancel the installation?"
msgstr "Действительно отменить установку?"

#: gui.py:254
msgid "Cancel"
msgstr "Отмена"

#: gui.py:263
msgid "Installation succeeded!"
msgstr "Установка выполнена успешно!"

#: gui.py:263 gui.py:265
msgid "Installation"
msgstr "Установка"

#: gui.py:265
msgid "Installation failed!"
msgstr "Сбой установки!"

#: gui.py:281
msgid "About"
msgstr "О программе"

#: gui.py:312
msgid "Authors"
msgstr "Авторы"

#: gui.py:315
msgid "Original WinUSB Developer"
msgstr "Первоначальный разработчик WinUSB"

